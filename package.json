{
  "name": "taskaude",
  "version": "0.1.0",
  "type": "module",
  "description": "Claude Code background task monitor",
  "bin": {
    "taskaude": "./bin/taskaude.js"
  },
  "scripts": {
    "build": "vite build --config web/vite.config.js",
    "start": "node bin/taskaude.js",
    "dev": "concurrently \"cross-env NODE_ENV=development node bin/taskaude.js\" \"vite --config web/vite.config.js\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ansi-to-html": "^0.7.2",
    "chokidar": "^3.6.0",
    "express": "^4.19.0",
    "open": "^10.1.0",
    "pg": "^8.20.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.39.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
